{
  "manifest_version": 3,
  "name": "PhoneCam",
  "version": "1.0.0",
  "key": "",
  "description": "Use your Android phone as a camera and microphone in Google Meet and other browser video calls.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PhoneCam",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://discord.com/*",
        "https://meet.jit.si/*",
        "https://whereby.com/*",
        "http://localhost/test.html*",
        "http://127.0.0.1/test.html*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://discord.com/*",
        "https://meet.jit.si/*",
        "https://whereby.com/*",
        "http://localhost/test.html*",
        "http://127.0.0.1/test.html*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
